---
// src/pages/index.astro
import BaseLayout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Projects.astro";
import Skills from "../components/Skills.astro";
import BlogCard from "../components/molecules/BlogCard.astro";
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
  .map(post => {
    const wordCount = post.body?.split(/\s+/).length || 0;
    return {
      ...post,
      readingTime: Math.ceil(wordCount / 200)
    };
  });

const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith("/") ? baseUrl : baseUrl + "/";
---

<BaseLayout
	title="Jesús Andrés - Desarrollador Web"
	description="Estudiante de Ingeniería en Sistemas apasionado por el desarrollo web y la tecnología"
>
	<Hero />

  <!-- Franja de Estadísticas (El Puente) -->
  <section class="py-10 border-y border-subtle app-surface-muted backdrop-blur-md relative z-20">
    <div class="max-w-7xl mx-auto px-4 md:px-8 lg:px-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center divide-y md:divide-y-0 md:divide-x border-subtle">
        <div class="py-4 md:py-0 scroll-animate">
          <div class="text-4xl md:text-5xl font-extrabold app-text mb-2">4+</div>
          <div class="app-muted font-medium tracking-wide uppercase text-xs sm:text-sm">Proyectos Publicados</div>
        </div>
        <div class="py-4 md:py-0 scroll-animate scroll-delay-1">
          <div class="text-4xl md:text-5xl font-extrabold app-text mb-2">2</div>
          <div class="app-muted font-medium tracking-wide uppercase text-xs sm:text-sm">Hackathons Interledger</div>
        </div>
        <div class="py-4 md:py-0 scroll-animate scroll-delay-2">
          <div class="text-4xl md:text-5xl font-extrabold text-cyan-500 dark:text-cyan-400 mb-2">React</div>
          <div class="app-muted font-medium tracking-wide uppercase text-xs sm:text-sm">Astro, Node y UI</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección de Proyectos Destacados -->
  <section class="py-20 app-surface-muted">
    <div class="max-w-7xl mx-auto px-4 md:px-8 lg:px-12">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6 scroll-animate">
        <div class="max-w-2xl">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">
            Casos de estudio <span class="text-cyan-700 dark:text-cyan-300">destacados</span>
          </h2>
          <p class="app-muted text-lg">
            Proyectos con contexto, decisiones técnicas y resultados visibles.
          </p>
        </div>
        <a 
          href={normalizedBase + "projects/"}
          class="inline-flex items-center gap-2 text-cyan-700 dark:text-cyan-300 font-semibold hover:underline group"
        >
          Ver todos los proyectos
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
      
      <Projects limit={2} showTitle={false} />
    </div>
  </section>

  <!-- Sección de Habilidades -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 md:px-8 lg:px-12">
      <div class="text-center mb-16 scroll-animate">
          <h2 class="text-3xl md:text-4xl font-bold mb-4 app-text">
          Stack <span class="text-cyan-400">con evidencia</span>
          </h2>
          <p class="app-muted text-lg max-w-2xl mx-auto">
          Tecnologías que uso en proyectos reales, prototipos y experiencias interactivas.
          </p>
      </div>
      
      <Skills showTitle={false} />

      <div class="mt-12 text-center">
        <a 
          href={normalizedBase + "skills/"}
          class="inline-flex items-center gap-2 px-8 py-3 brand-button font-bold rounded-xl hover:-translate-y-0.5 transition-all duration-300"
        >
          Explorar todas mis habilidades
        </a>
      </div>
    </div>
  </section>

  <!-- Sección de Blog -->
  <section class="py-20 app-surface-muted">
    <div class="max-w-7xl mx-auto px-4 md:px-8 lg:px-12">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6 scroll-animate">
        <div class="max-w-2xl">
          <h2 class="text-3xl md:text-4xl font-bold mb-4 app-text">
            Últimas entradas del <span class="text-cyan-400">Blog</span>
          </h2>
          <p class="app-muted text-lg">
            Compartiendo mi camino, aprendizajes y reflexiones tecnológicas.
          </p>
        </div>
        <a 
          href={normalizedBase + "blog/"}
          class="inline-flex items-center gap-2 brand-text font-semibold hover:underline group"
        >
          Ir al blog completo
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {latestPosts.map((post) => (
          <BlogCard 
            id={post.id}
            title={post.data.title}
            date={post.data.date.toISOString()}
            image={post.data.image}
            description={post.data.description}
            tags={post.data.tags}
            readingTime={post.readingTime}
          />
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
