---
// JellyfishCanvas.astro
// Bioluminescent jellyfish that follows the cursor.
// Uses IK chain physics per tentacle — same technique as the fish skeleton reference.
// Drop this component in the hero section to replace the photo.
// Usage: <JellyfishCanvas />
---

<div class="jellyfish-wrapper">
  <canvas id="jellyfish-canvas"></canvas>
</div>

<style>
  .jellyfish-wrapper {
    width: 100%;
    height: 100%;
    min-height: 400px;
    border-radius: inherit;
    overflow: hidden;
    position: relative;
    background: #050a12;
  }

  #jellyfish-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: none;
  }
</style>

<script>
  const canvas = document.getElementById(
    "jellyfish-canvas"
  ) as HTMLCanvasElement;

  if (canvas) {
    const ctx = canvas.getContext("2d")!;
    const wrapper = canvas.parentElement!;

    // ─── State ────────────────────────────────────────────────
    let W = 0,
      H = 0;
    let mouse = { x: 0, y: 0, active: false };
    let bodyX = 0,
      bodyY = 0,
      bodyVX = 0,
      bodyVY = 0;
    let floatA = 0;
    let bodyAngle = 0; // The rotation of the jellyfish bell

    // ─── Tentacle definitions ─────────────────────────────────
    // angle: horizontal spread from center
    // len:   segment length in px
    // seg:   number of IK segments
    // thick: whether to render nematocyst bumps
    const TENTACLE_DEFS = [
      { angle: -0.55, len: 18, seg: 7,  thick: true  },
      { angle: -0.25, len: 22, seg: 8,  thick: false },
      { angle:  0,    len: 24, seg: 9,  thick: true  },
      { angle:  0.25, len: 22, seg: 8,  thick: false },
      { angle:  0.55, len: 18, seg: 7,  thick: true  },
      { angle: -0.38, len: 20, seg: 8,  thick: false },
      { angle:  0.38, len: 20, seg: 8,  thick: false },
      { angle: -0.12, len: 26, seg: 10, thick: false },
      { angle:  0.12, len: 26, seg: 10, thick: false },
    ];

    interface TentacleNode {
      x: number;
      y: number;
      vx: number;
      vy: number;
    }

    interface Tentacle {
      segs: TentacleNode[];
      cfg: (typeof TENTACLE_DEFS)[number];
    }

    let tentacles: Tentacle[] = [];

    // ─── Resize ───────────────────────────────────────────────
    function resize() {
      const dpr = window.devicePixelRatio || 1;
      const rect = wrapper.getBoundingClientRect();
      W = rect.width;
      H = rect.height;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      canvas.style.width = W + "px";
      canvas.style.height = H + "px";
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    // ─── Init tentacles ───────────────────────────────────────
    function initTentacles() {
      const startX = bodyX || W / 2;
      const startY = bodyY || H / 2;
      tentacles = TENTACLE_DEFS.map((cfg) => {
        const segs: TentacleNode[] = [];
        for (let i = 0; i <= cfg.seg; i++) {
          segs.push({
            x: startX,
            y: startY + (i * cfg.len * 3) / cfg.seg,
            vx: 0,
            vy: 0,
          });
        }
        return { segs, cfg };
      });
    }

    // ─── Physics: body ────────────────────────────────────────
    function updateBody() {
      let tx: number, ty: number;

      if (mouse.active) {
        tx = mouse.x;
        ty = mouse.y;
      } else {
        // Autonomous gentle float when cursor is outside
        floatA += 0.009;
        tx = W / 2 + Math.sin(floatA) * W * 0.2;
        ty = H / 2 + Math.sin(floatA * 0.6) * H * 0.13;
      }

      const dx = tx - bodyX;
      const dy = ty - bodyY;
      const dist = Math.sqrt(dx * dx + dy * dy);

      // Desired angle towards target (+PI/2 because top of bell is at angle 0 in ctx rotation)
      let targetAngle = bodyAngle;
      if (dist > 5 || mouse.active) {
        targetAngle = Math.atan2(dy, dx) + Math.PI / 2;
      }

      // Smoothly rotate towards targetAngle
      let diff = targetAngle - bodyAngle;
      while (diff > Math.PI) diff -= Math.PI * 2;
      while (diff < -Math.PI) diff += Math.PI * 2;
      bodyAngle += diff * 0.08;

      // Burst velocity linked to pulse animation
      const now = Date.now() * 0.001;
      const pulse = Math.sin(now * 1.8);
      
      // When pulse gives a strong value, apply forward thrust
      const force = Math.max(0, pulse * 1.5);
      const dirX = Math.sin(bodyAngle); 
      const dirY = -Math.cos(bodyAngle); // -cos because upward is -Y

      bodyVX += dirX * force * 0.3;
      bodyVY += dirY * force * 0.3;

      // Gentle continuous attraction to target
      bodyVX += dx * 0.002;
      bodyVY += dy * 0.002;

      // Higher water friction
      bodyVX *= 0.88;
      bodyVY *= 0.88;
      
      bodyX += bodyVX;
      bodyY += bodyVY;
    }

    // ─── Physics: tentacles (IK chain) ────────────────────────
    function updateTentacles() {
      const now = Date.now() * 0.001;

      for (const t of tentacles) {
        const { segs, cfg } = t;

        // Calculate attachment point rotated by bodyAngle
        const attachX = Math.sin(cfg.angle) * 18;
        const attachY = Math.cos(cfg.angle) * 8 + 12;
        
        const cosA = Math.cos(bodyAngle);
        const sinA = Math.sin(bodyAngle);
        const rotX = attachX * cosA - attachY * sinA;
        const rotY = attachX * sinA + attachY * cosA;

        // Root is pinned just below bell skirt
        segs[0].x = bodyX + rotX;
        segs[0].y = bodyY + rotY;

        const segLen = (cfg.len * 3) / cfg.seg;

        for (let i = 1; i < segs.length; i++) {
          const s = segs[i];
          const p = segs[i - 1];
          const frac = i / segs.length;

          // Lateral wave + gravity increasing toward tip
          const wave =
            Math.sin(now * 1.4 + cfg.angle * 3 + i * 0.5) *
            1.8 *
            (1 + frac);
          s.vx += wave * 0.08 + (Math.random() - 0.5) * 0.05;
          s.vy += 0.18 + frac * 0.12;

          // Damping
          s.vx *= 0.88;
          s.vy *= 0.88;

          s.x += s.vx;
          s.y += s.vy;

          // IK constraint: maintain segment length
          const dx = s.x - p.x;
          const dy = s.y - p.y;
          const dist = Math.sqrt(dx * dx + dy * dy) || 1;
          const diff = (dist - segLen) / dist;
          s.x -= dx * diff * 0.5;
          s.y -= dy * diff * 0.5;
        }
      }
    }

    // ─── Draw: bell ───────────────────────────────────────────
    function drawBell() {
      const now = Date.now() * 0.001;
      const pulse = Math.sin(now * 1.8) * 0.06;
      const rx = 38 + pulse * 20;
      const ry = 28 + pulse * 12;
      const bcy = -ry * 0.1; // bell center Y relative to 0

      ctx.save();
      ctx.translate(bodyX, bodyY);
      ctx.rotate(bodyAngle);

      // Outer ambient glow
      const og = ctx.createRadialGradient(0, 0, ry * 0.2, 0, 0, rx * 1.6);
      og.addColorStop(0, "rgba(59,130,246,0.08)");
      og.addColorStop(1, "rgba(59,130,246,0)");
      ctx.beginPath();
      ctx.ellipse(0, 0, rx * 1.6, ry * 1.6, 0, 0, Math.PI * 2);
      ctx.fillStyle = og;
      ctx.fill();

      // Bell shape: dome + skirt flare
      ctx.beginPath();
      ctx.ellipse(0, bcy, rx, ry, 0, Math.PI, Math.PI * 2);
      ctx.lineTo(rx, 0);
      ctx.quadraticCurveTo(rx * 1.15, ry * 0.4, rx * 0.7, ry * 0.5);
      ctx.lineTo(-rx * 0.7, ry * 0.5);
      ctx.quadraticCurveTo(-rx * 1.15, ry * 0.4, -rx, 0);
      ctx.closePath();

      const bg = ctx.createRadialGradient(0, -ry * 0.3, 2, 0, 0, ry * 1.1);
      bg.addColorStop(0, "rgba(147,197,253,0.18)");
      bg.addColorStop(0.4, "rgba(59,130,246,0.09)");
      bg.addColorStop(1, "rgba(29,78,216,0.04)");
      ctx.fillStyle = bg;
      ctx.fill();

      // Bell outline
      ctx.beginPath();
      ctx.ellipse(0, bcy, rx, ry, 0, Math.PI, Math.PI * 2);
      ctx.lineTo(rx, 0);
      ctx.quadraticCurveTo(rx * 1.15, ry * 0.4, rx * 0.7, ry * 0.5);
      ctx.lineTo(-rx * 0.7, ry * 0.5);
      ctx.quadraticCurveTo(-rx * 1.15, ry * 0.4, -rx, 0);
      ctx.closePath();
      ctx.strokeStyle = "rgba(147,197,253,0.55)";
      ctx.lineWidth = 1;
      ctx.stroke();

      // Inner radial ribs
      for (let i = 0; i < 8; i++) {
        const a = Math.PI + ((i + 0.5) / 8) * Math.PI;
        ctx.beginPath();
        ctx.moveTo(0, bcy);
        ctx.lineTo(Math.cos(a) * rx * 0.85, bcy + Math.sin(a) * ry * 0.85);
        ctx.strokeStyle = "rgba(147,197,253,0.1)";
        ctx.lineWidth = 0.7;
        ctx.stroke();
      }

      // Oral arms (4 short wavy appendages at center bottom)
      const now2 = Date.now() * 0.0008;
      for (let i = 0; i < 4; i++) {
        const oa = ((i / 4) * Math.PI * 2) + now2 * 0.4;
        const ox = Math.cos(oa) * rx * 0.25;
        const oy = ry * 0.45;
        ctx.beginPath();
        ctx.moveTo(ox, oy);
        ctx.quadraticCurveTo(
          ox + Math.sin(now2 + i * 1.5) * 10, oy + ry * 0.3,
          ox + Math.sin(now2 * 1.2 + i) * 8, oy + ry * 0.6
        );
        ctx.strokeStyle = "rgba(96,165,250,0.35)";
        ctx.lineWidth = 1.2;
        ctx.stroke();
      }

      // Center nucleus glow
      const cg = ctx.createRadialGradient(0, -ry * 0.25, 0, 0, -ry * 0.25, rx * 0.35);
      cg.addColorStop(0, "rgba(219,234,254,0.55)");
      cg.addColorStop(1, "rgba(59,130,246,0)");
      ctx.beginPath();
      ctx.ellipse(0, -ry * 0.25, rx * 0.35, ry * 0.28, 0, 0, Math.PI * 2);
      ctx.fillStyle = cg;
      ctx.fill();

      ctx.restore();
    }

    // ─── Draw: tentacles ──────────────────────────────────────
    function drawTentacles() {
      for (const t of tentacles) {
        const { segs, cfg } = t;
        if (segs.length < 2) continue;

        for (let i = 1; i < segs.length; i++) {
          const p = segs[i - 1];
          const c = segs[i];
          const frac = i / segs.length;

          const thick = cfg.thick
            ? (1 - frac) * 2.2 + 0.4
            : (1 - frac) * 1.4 + 0.3;
          const alpha = (1 - frac * 0.75) * 0.7;

          ctx.beginPath();
          ctx.moveTo(p.x, p.y);
          ctx.lineTo(c.x, c.y);
          ctx.strokeStyle = `rgba(96,165,250,${alpha})`;
          ctx.lineWidth = thick;
          ctx.stroke();

          // Nematocyst bumps on thick tentacles every 2 segments
          if (cfg.thick && i % 2 === 0 && frac < 0.85) {
            ctx.beginPath();
            ctx.arc(c.x, c.y, thick * 0.9, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(147,197,253,${alpha * 0.8})`;
            ctx.fill();
          }
        }

        // Tip glow
        const tip = segs[segs.length - 1];
        ctx.beginPath();
        ctx.arc(tip.x, tip.y, 1.2, 0, Math.PI * 2);
        ctx.fillStyle = "rgba(191,219,254,0.6)";
        ctx.shadowBlur = 6;
        ctx.shadowColor = "rgba(147,197,253,0.8)";
        ctx.fill();
        ctx.shadowBlur = 0;
      }
    }

    // ─── Render loop ──────────────────────────────────────────
    function draw() {
      ctx.clearRect(0, 0, W, H);
      drawTentacles();
      drawBell();
    }

    function animate() {
      updateBody();
      updateTentacles();
      draw();
      requestAnimationFrame(animate);
    }

    // ─── Click: impulse burst ─────────────────────────────────
    function impulse() {
      bodyVX += (Math.random() - 0.5) * 12;
      bodyVY += (Math.random() - 0.5) * 12;
      for (const t of tentacles) {
        for (const s of t.segs) {
          s.vx += (Math.random() - 0.5) * 8;
          s.vy += (Math.random() - 0.5) * 8;
        }
      }
    }

    // ─── Events ───────────────────────────────────────────────
    canvas.addEventListener("mousemove", (e) => {
      const r = canvas.getBoundingClientRect();
      mouse.x = (e.clientX - r.left) * (W / r.width);
      mouse.y = (e.clientY - r.top) * (H / r.height);
      mouse.active = true;
    });

    canvas.addEventListener("mouseleave", () => {
      mouse.active = false;
    });

    canvas.addEventListener("click", impulse);

    canvas.addEventListener(
      "touchmove",
      (e) => {
        e.preventDefault();
        const r = canvas.getBoundingClientRect();
        const touch = e.touches[0];
        mouse.x = (touch.clientX - r.left) * (W / r.width);
        mouse.y = (touch.clientY - r.top) * (H / r.height);
        mouse.active = true;
      },
      { passive: false }
    );

    canvas.addEventListener("touchstart", (e) => {
      const r = canvas.getBoundingClientRect();
      const touch = e.touches[0];
      mouse.x = (touch.clientX - r.left) * (W / r.width);
      mouse.y = (touch.clientY - r.top) * (H / r.height);
      mouse.active = true;
      impulse();
    });

    canvas.addEventListener("touchend", () => {
      mouse.active = false;
    });

    // ─── ResizeObserver ───────────────────────────────────────
    const ro = new ResizeObserver(() => {
      resize();
      // Re-center body on resize
      bodyX = W / 2;
      bodyY = H / 2;
    });
    ro.observe(wrapper);

    // ─── Init ─────────────────────────────────────────────────
    resize();
    bodyX = W / 2;
    bodyY = H / 2;
    initTentacles();
    animate();
  }
</script>