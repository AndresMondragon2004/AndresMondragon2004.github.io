---
// Timeline.astro - Línea de tiempo interactiva de experiencia

const timelineEvents = [
  {
    year: "2022",
    title: "Inicio de la carrera",
    description: "Comencé mis estudios en Ingeniería en Sistemas Computacionales, descubriendo mi pasión por la programación.",
    icon: "",
    type: "education",
  },
  {
    year: "2023",
    title: "Primer juego y proyectos web",
    description: "Desarrollé mi primer juego utilizando únicamente Python nativo. Además, di mis primeros pasos en web creando proyectos con HTML, CSS y JavaScript.",
    icon: "",
    type: "project",
  },
  {
    year: "2024",
    title: "Breakout Clone — Game Dev",
    description: "Hice el clon del clásico Breakout en Godot Engine con mecánicas y sonidos.",
    icon: "",
    type: "project",
  },
  {
    year: "Sep 2025",
    title: "Primer Hackathon — Interledger",
    description: "Participé en mi primer hackathon, desarrollando una plataforma de pagos para artesanos con la tecnología de Interledger.",
    icon: "",
    type: "achievement",
  },
  {
    year: "Nov 2025",
    title: "Hackathon CDMX — OpenWallet",
    description: "Desarrollé OpenWallet, una app bancaria interactiva usando React Native y el protocolo Open Payments de Interledger.",
    icon: "",
    type: "achievement",
  },
  {
    year: "Dic 2025",
    title: "Portafolio y Blog Personal",
    description: "Desarrollé mi portafolio y blog personal interactivo para documentar mi progreso y mis habilidades como desarrollador.",
    icon: "",
    type: "project",
  },
  {
    year: "2026",
    title: "Nuevos Proyectos",
    description: "Sigo desarrollando múltiples proyectos que más adelante estaré subiendo y agregando a mis repositorios de GitHub.",
    icon: "",
    type: "current",
  },
];

const typeColors: Record<string, { surface: string; border: string; dot: string; badge: string }> = {
  education: {
    surface: "bg-sky-50 dark:bg-sky-950/35",
    border: "border-sky-500 dark:border-sky-400",
    dot: "bg-sky-500",
    badge: "bg-sky-100 text-sky-900 dark:bg-sky-900/70 dark:text-sky-100",
  },
  project: {
    surface: "bg-violet-50 dark:bg-violet-950/35",
    border: "border-violet-500 dark:border-violet-400",
    dot: "bg-violet-500",
    badge: "bg-violet-100 text-violet-900 dark:bg-violet-900/70 dark:text-violet-100",
  },
  achievement: {
    surface: "bg-amber-50 dark:bg-amber-950/35",
    border: "border-amber-500 dark:border-amber-400",
    dot: "bg-amber-500",
    badge: "bg-amber-100 text-amber-950 dark:bg-amber-900/70 dark:text-amber-100",
  },
  current: {
    surface: "bg-emerald-50 dark:bg-emerald-950/35",
    border: "border-emerald-500 dark:border-emerald-400",
    dot: "bg-emerald-500",
    badge: "bg-emerald-100 text-emerald-950 dark:bg-emerald-900/70 dark:text-emerald-100",
  },
};
---

<section class="py-16">
  <div class="max-w-4xl mx-auto px-4 md:px-8 lg:px-12">

    <!-- Título -->
    <div class="text-center mb-14 scroll-animate">
      <h2 class="text-4xl md:text-5xl font-bold mb-3">
        Mi <span class="brand-text">Trayectoria</span>
      </h2>
      <p class="app-muted">
        El camino que me ha traído hasta aquí
      </p>
      <div class="h-1 w-32 brand-gradient rounded-full mx-auto mt-4"></div>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Línea central -->
      <div class="absolute left-6 md:left-1/2 top-0 bottom-0 w-0.5 brand-gradient md:-translate-x-px"></div>

      {timelineEvents.map((event, index) => {
        const colors = typeColors[event.type];
        const isEven = index % 2 === 0;
        
        return (
          <div class={`relative flex items-start mb-10 md:mb-12 scroll-animate ${isEven ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
            
            {/* Dot on the line */}
            <div class={`absolute left-6 md:left-1/2 w-4 h-4 rounded-full ${colors.dot} border-4 border-white dark:border-gray-900 -translate-x-1/2 z-10 shadow-lg`}></div>

            {/* Spacer for mobile */}
            <div class="w-14 md:hidden flex-shrink-0"></div>

            {/* Content card */}
            <div class={`flex-1 ${isEven ? 'md:pr-12 md:text-right' : 'md:pl-12 md:text-left'}`}>
              <div class={`relative p-5 rounded-2xl border ${colors.surface} ${colors.border} border-l-4 md:border-l-0 ${isEven ? `md:border-r-4` : `md:border-l-4`} shadow-sm hover:shadow-lg transition-shadow duration-300`}>
                
                {/* Year badge */}
                <span class={`inline-block px-3 py-1 rounded-full text-xs font-bold mb-2 shadow-sm ${colors.badge}`}>
                  {event.year}
                </span>

                {/* Icon + Title */}
                <div class={`flex items-center gap-2 mb-2 ${isEven ? 'md:justify-end' : ''}`}>
                  <span class="text-xl">{event.icon}</span>
                  <h3 class="text-lg font-bold text-slate-950 dark:text-white">
                    {event.title}
                  </h3>
                </div>

                {/* Description */}
                <p class="text-sm text-slate-700 dark:text-slate-200 leading-relaxed">
                  {event.description}
                </p>
              </div>
            </div>

            {/* Spacer for desktop alternating layout */}
            <div class="hidden md:block flex-1"></div>
          </div>
        );
      })}
    </div>

  </div>
</section>
