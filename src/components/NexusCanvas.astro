---
// NexusCanvas.astro
// Animación interactiva de una constelación de partículas espaciales.
// Incluye: Gravedad suave, Formación Geométrica Dinámica y Pulsos de Energía.
---

<div class="constellation-wrapper">
  <canvas 
    id="constellation-canvas" 
    role="img" 
    aria-label="Animación interactiva de red neuronal con figuras geométricas"
  ></canvas>
</div>

<style>
  .constellation-wrapper {
    width: 100%;
    height: 100%; 
    min-height: 260px;
    border-radius: 0.875rem;
    overflow: hidden;
    position: relative;
    background: radial-gradient(circle at 30% 30%, #18181b 0%, #09090b 80%, #000000 100%);
  }

  @media (min-width: 640px) {
    .constellation-wrapper {
      min-height: 320px;
    }
  }

  @media (min-width: 768px) {
    .constellation-wrapper {
      min-height: 500px;
      border-radius: 1rem;
    }
  }

  #constellation-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: crosshair;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
  }
</style>

<script>
  function initConstellation() {
    const canvas = document.getElementById("constellation-canvas") as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext("2d")!;
    const wrapper = canvas.parentElement!;
    let animationFrameId: number;

    const isCompact = () => wrapper.getBoundingClientRect().width < 640;
    const getNodeCount = () => (isCompact() ? 40 : 70); 
    const getStarCount = () => (isCompact() ? 90 : 250);
    const getConnectionRadius = () => (isCompact() ? 90 : 140);
    const getLeaderRadius = () => (isCompact() ? 150 : 220);
    const getRepelRadius = () => (isCompact() ? 60 : 100);
    const DAMPING = 0.88;  
    
    const PAL = {
      leaderGlow: "rgba(34,211,238,0.6)",
      pulseGlow: "rgba(34,211,238,1)",
      nodeViolet: "#ffffff",
      nodePink: "#a1a1aa",
    };

    interface ShapePos { rx: number; ry: number; }

    interface Node {
      x: number; y: number;
      vx: number; vy: number;
      size: number;
      opacity: number;
      color: string;
      pulseOffset: number;
      homeOrbitRadius: number;
      homeOrbitAngle: number;
      orbitSpeed: number;
      orbitTilt: number;
      drift: number;
    }

    interface Star {
      x: number; y: number;
      r: number; o: number;
      vx: number; vy: number;
      twinkleSpeed: number;
    }

    interface Pulse {
      fromNode: Node;
      toNode: Node;
      progress: number;
      speed: number;
    }

    let nodes: Node[] = [];
    let stars: Star[] = [];
    let pulses: Pulse[] = [];
    let mouse = { x: -9999, y: -9999, active: false, idleTime: 0 };
    let W = 0, H = 0, cx = 0, cy = 0;
    let dispersed = false;
    let disperseTime = 0;
    
    // Control de formas
    let currentShape = 0;
    let shapeTimer = 0;

    const leaderCache = document.createElement('canvas');
    const nodeCacheA = document.createElement('canvas'); 
    const nodeCacheB = document.createElement('canvas'); 

    function preRender() {
      // Líder
      leaderCache.width = leaderCache.height = 40;
      const lctx = leaderCache.getContext('2d')!;
      lctx.shadowBlur = 15;
      lctx.shadowColor = PAL.leaderGlow;
      lctx.fillStyle = "#ffffff";
      lctx.beginPath();
      lctx.arc(20, 20, 6, 0, Math.PI * 2);
      lctx.fill();

      // Satélite A
      nodeCacheA.width = nodeCacheA.height = 20;
      const actx = nodeCacheA.getContext('2d')!;
      actx.fillStyle = PAL.nodeViolet;
      actx.beginPath();
      actx.arc(10, 10, 3, 0, Math.PI * 2);
      actx.fill();

      // Satélite B
      nodeCacheB.width = nodeCacheB.height = 20;
      const bctx = nodeCacheB.getContext('2d')!;
      bctx.fillStyle = PAL.nodePink;
      bctx.beginPath();
      bctx.arc(10, 10, 2, 0, Math.PI * 2);
      bctx.fill();
    }

    function initStars() {
      stars = [];
      const starCount = getStarCount();
      for (let i = 0; i < starCount; i++) {
        stars.push({
          x: Math.random() * W,
          y: Math.random() * H,
          r: 0.2 + Math.random() * 0.8,
          o: 0.1 + Math.random() * 0.4,
          vx: (Math.random() - 0.5) * 0.08,
          vy: (Math.random() - 0.5) * 0.08,
          twinkleSpeed: 0.001 + Math.random() * 0.0025
        });
      }
    }

    function initNodes() {
      nodes = [];
      const nodeCount = getNodeCount();
      const R = Math.min(W, H) * 0.35; // Radio base para las figuras

      for (let i = 0; i < nodeCount; i++) {
        // Flor de Fibonacci (Espiral de Fermat / Girasol)
        const t0 = (i + 1) / nodeCount;
        const angle0 = i * 2.399963;
        const radius0 = Math.sqrt(t0) * (R * 1.5);
        
        nodes.push({
          x: cx + (Math.random() - 0.5) * 80,
          y: cy + (Math.random() - 0.5) * 80,
          vx: 0, vy: 0,
          size: i === 0 ? 6 : 1.1 + Math.random() * 2.5,
          opacity: 0.3 + Math.random() * 0.6,
          color: i % 2 === 0 ? "A" : "B",
          pulseOffset: Math.random() * Math.PI * 2,
          homeOrbitRadius: radius0,
          homeOrbitAngle: angle0
        });
      }
    }

    let lastTime = Date.now();

    function update() {
      const now = Date.now();
      const delta = now - lastTime;
      lastTime = now;

      // Recuperación de la explosión por clic
      const recovering = dispersed && now - disperseTime > 600;
      if (dispersed && now - disperseTime > 2600) dispersed = false;

      // Lógica de inactividad para Formas
      // Detecta si el cursor está fuera (mouse.active = false) o si no se ha movido
      if (!mouse.active) {
        mouse.idleTime += delta;
      } else {
        mouse.idleTime = 0;
        currentShape = 0; // Regresa al caos
        shapeTimer = 0;
        pulses = []; // Apaga los pulsos
      }

      // Cambiar de forma cada 8 segundos si está inactivo
      if (mouse.idleTime > 4000 && !dispersed) {
        if (currentShape === 0) {
          currentShape = 1; // Primer forma: Hexágono
          shapeTimer = 0;
        } else {
          shapeTimer += delta;
          if (shapeTimer > 8000) {
            shapeTimer = 0;
            currentShape = currentShape === 5 ? 1 : currentShape + 1;
            pulses = []; // Reiniciar pulsos en transición
          }
        }
      }

      // Generar Pulsos Aleatorios Hacia el Líder
      if (currentShape !== 0 && mouse.idleTime > 6000) {
        if (Math.random() < 0.02) { // 2% probabilidad (1 o 2 por segundo, mucho menos caos)
          const fromIdx = Math.floor(1 + Math.random() * (nodes.length - 1));
          const toIdx = 0; // 100% certeras hacia el orbe maestro
          const a = nodes[fromIdx];
          const b = nodes[toIdx];
          if (a !== b) {
            pulses.push({
              fromNode: a,
              toNode: b,
              progress: 0,
              speed: 0.008 + Math.random() * 0.01 // Velocidad reducida y elegante
            });
          }
        }
      }

      // Actualizar estrellas
      stars.forEach(s => {
        s.x += s.vx;
        s.y += s.vy;
        if (s.x < 0) s.x = W;
        if (s.x > W) s.x = 0;
        if (s.y < 0) s.y = H;
        if (s.y > H) s.y = 0;
      });

      const baseSpring = dispersed ? (recovering ? 0.045 : 0.008) : 0.035;
      const spring = currentShape === 0 ? baseSpring : 0.02; // Más lento al armar figuras
      
      const R = Math.min(W, H) * 0.35;
      const rot = now * 0.0003; // Rotación lenta dinámica

      for (let i = 0; i < nodes.length; i++) {
        const n = nodes[i];
        
        if (i === 0) {
          // LÍDER: Sigue el ratón o levita al centro
          const targetX = mouse.active ? mouse.x : cx;
          const targetY = mouse.active ? mouse.y : cy + Math.sin(now * 0.002) * 20;
          
          n.vx += (targetX - n.x) * 0.15;
          n.vy += (targetY - n.y) * 0.15;
        } else {
          // Calcular target dinámicamente según la forma actual
          let targetX = cx;
          let targetY = cy;
          const totalSatellites = nodes.length - 1;
          const idx = i - 1;

          if (currentShape === 0) {
            // Flor giratoria (Espiral matemática)
            targetX = cx + Math.cos(n.homeOrbitAngle + rot) * n.homeOrbitRadius;
            targetY = cy + Math.sin(n.homeOrbitAngle + rot) * n.homeOrbitRadius;
          } else if (currentShape === 1) {
            // Hexágono
            const side = idx % 6;
            const pt = Math.floor(idx / 6) / Math.ceil(totalSatellites / 6);
            const a1 = side * Math.PI / 3 + rot;
            const a2 = ((side + 1) % 6) * Math.PI / 3 + rot;
            const x1 = Math.cos(a1) * R;
            const y1 = Math.sin(a1) * R;
            const x2 = Math.cos(a2) * R;
            const y2 = Math.sin(a2) * R;
            targetX = cx + x1 + (x2 - x1) * pt;
            targetY = cy + y1 + (y2 - y1) * pt;
          } else if (currentShape === 2) {
            // Infinito (Lemniscata)
            const t2 = (idx / totalSatellites) * Math.PI * 2 + rot;
            const scale2 = (R * 1.2) / (1 + Math.pow(Math.sin(t2), 2));
            targetX = cx + scale2 * Math.cos(t2);
            targetY = cy + scale2 * Math.cos(t2) * Math.sin(t2);
          } else if (currentShape === 3) {
            // Triángulo
            const side = idx % 3;
            const pt = Math.floor(idx / 3) / Math.ceil(totalSatellites / 3);
            const a1 = side * Math.PI * 2 / 3 - Math.PI / 2 + rot;
            const a2 = ((side + 1) % 3) * Math.PI * 2 / 3 - Math.PI / 2 + rot;
            const x1 = Math.cos(a1) * R;
            const y1 = Math.sin(a1) * R;
            const x2 = Math.cos(a2) * R;
            const y2 = Math.sin(a2) * R;
            targetX = cx + x1 + (x2 - x1) * pt;
            targetY = cy + y1 + (y2 - y1) * pt;
          } else if (currentShape === 4) {
            // ADN (Doble Hélice)
            const isStrandA = idx % 2 === 0;
            const pt = Math.floor(idx / 2) / (totalSatellites / 2); // 0.0 a 1.0
            
            // Extenderse a lo largo del eje X
            const xPos = -R * 1.4 + pt * (R * 2.8);
            
            // La onda se desplaza con el tiempo (rot) para dar la ilusión de rotación 3D
            const phase = pt * Math.PI * 3 + (rot * 3); 
            const yOffset = Math.sin(isStrandA ? phase : phase + Math.PI) * (R * 0.45);
            
            // Rotar toda la cadena para que flote girando suavemente
            const baseRot = rot * 0.5;
            const finalX = xPos * Math.cos(baseRot) - yOffset * Math.sin(baseRot);
            const finalY = xPos * Math.sin(baseRot) + yOffset * Math.cos(baseRot);
            
            targetX = cx + finalX;
            targetY = cy + finalY;
          } else if (currentShape === 5) {
            // Estrella de 4 Puntas (Astroide)
            const tStar = (idx / totalSatellites) * Math.PI * 2 + rot;
            // Ecuación paramétrica de un astroide: cos^3 y sin^3
            const xStar = Math.pow(Math.cos(tStar), 3) * (R * 1.5);
            const yStar = Math.pow(Math.sin(tStar), 3) * (R * 1.5);
            targetX = cx + xStar;
            targetY = cy + yStar;
          }

          n.vx += (targetX - n.x) * spring;
          n.vy += (targetY - n.y) * spring;

          // Repulsión del mouse 
          if (mouse.active && currentShape === 0 && !dispersed) {
            const dx = mouse.x - n.x;
            const dy = mouse.y - n.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            const repelRadius = getRepelRadius();
            
            if (dist < repelRadius) {
              const f = (1 - dist / repelRadius) * 0.8;
              n.vx -= (dx / dist) * f;
              n.vy -= (dy / dist) * f;
            }
          }
        }

        n.vx *= DAMPING;
        n.vy *= DAMPING;
        n.x += n.vx;
        n.y += n.vy;
      }

      // Actualizar Pulsos
      pulses.forEach(p => { p.progress += p.speed; });
      pulses = pulses.filter(p => p.progress <= 1);
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      const time = Date.now();

      // Estrellas
      ctx.fillStyle = "#ffffff";
      stars.forEach(s => {
        const twinkle = 0.55 + Math.sin(time * s.twinkleSpeed) * 0.45;
        ctx.globalAlpha = s.o * twinkle;
        ctx.fillRect(s.x - s.r, s.y - s.r, s.r * 2, s.r * 2);
      });
      ctx.globalAlpha = 1;

      // Líneas de red
      ctx.lineWidth = 1.2;
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          const maxD = i === 0 ? getLeaderRadius() : getConnectionRadius();
          if (dist < maxD) {
            const alpha = Math.pow(1 - dist / maxD, 1.4) * (currentShape === 0 ? 0.85 : 0.3);
            ctx.strokeStyle = `rgba(34, 211, 238, ${alpha})`;
            ctx.beginPath();
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.stroke();
          }
        }
      }

      // Dibujar Pulsos de Energía ultra brillantes
      ctx.shadowBlur = 15;
      ctx.shadowColor = PAL.pulseGlow;
      ctx.fillStyle = "#ffffff";
      pulses.forEach(p => {
        const px = p.fromNode.x + (p.toNode.x - p.fromNode.x) * p.progress;
        const py = p.fromNode.y + (p.toNode.y - p.fromNode.y) * p.progress;
        
        ctx.globalAlpha = Math.sin(p.progress * Math.PI); // Fades in and out
        ctx.beginPath();
        // Pulsos más grandes para que destaquen mucho más
        ctx.arc(px, py, 4, 0, Math.PI * 2);
        ctx.fill();
      });
      ctx.shadowBlur = 0; // Apagar shadow
      ctx.globalAlpha = 1;

      // Nodos
      const timeSec = time * 0.002;
      nodes.forEach((n, i) => {
        if (i === 0) {
          ctx.drawImage(leaderCache, n.x - 20, n.y - 20);
        } else {
          const pulse = 0.96 + Math.sin(timeSec + n.pulseOffset) * 0.04;
          ctx.globalAlpha = n.opacity * pulse;
          const img = n.color === "A" ? nodeCacheA : nodeCacheB;
          ctx.drawImage(img, n.x - 10, n.y - 10);
        }
      });
      ctx.globalAlpha = 1;
    }

    function animate() {
      update();
      draw();
      animationFrameId = requestAnimationFrame(animate);
    }

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      const rect = wrapper.getBoundingClientRect();
      W = rect.width;
      H = rect.height;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.scale(dpr, dpr);
      cx = W / 2;
      cy = H / 2;
      initStars();
      initNodes(); // Recalcular posiciones home al redimensionar
    }

    const handleMove = (e: any) => {
      const r = canvas.getBoundingClientRect();
      const pos = e.touches ? e.touches[0] : e;
      mouse.x = pos.clientX - r.left;
      mouse.y = pos.clientY - r.top;
      mouse.active = true;
      mouse.idleTime = 0; // Reiniciar inactividad al mover
    };

    function disperse() {
      if (currentShape !== 0) return; // No explotar si está armando figuras
      nodes.forEach(n => {
        const a = Math.random() * Math.PI * 2;
        const f = 4 + Math.random() * 5;
        n.vx += Math.cos(a) * f;
        n.vy += Math.sin(a) * f;
      });
      dispersed = true;
      disperseTime = Date.now();
    }

    canvas.addEventListener("mousemove", handleMove);
    canvas.addEventListener("touchstart", (e) => { handleMove(e); disperse(); }, { passive: true });
    canvas.addEventListener("touchmove", handleMove, { passive: true });
    canvas.addEventListener("mouseleave", () => mouse.active = false);
    canvas.addEventListener("touchend", () => mouse.active = false);
    canvas.addEventListener("click", disperse);

    preRender();
    resize();
    window.addEventListener("resize", resize);
    animate();

    return () => {
      cancelAnimationFrame(animationFrameId);
      window.removeEventListener("resize", resize);
    };
  }

  initConstellation();
  document.addEventListener('astro:after-swap', initConstellation);
</script>
