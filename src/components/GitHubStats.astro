---
// GitHubStats.astro - Estadísticas de GitHub en vivo

const username = "AndresMondragon2004";
---

<section class="py-16">
  <div class="max-w-6xl mx-auto px-4 md:px-8 lg:px-12">

    <!-- Título -->
    <div class="text-center mb-12 scroll-animate">
      <h2 class="text-4xl md:text-5xl font-bold mb-3 text-white">
        Mi actividad en <span class="text-cyan-400">GitHub</span>
      </h2>
      <p class="text-zinc-400">
        Contribuciones, proyectos y estadísticas en tiempo real
      </p>
      <div class="h-1 w-32 bg-cyan-400 rounded-full mx-auto mt-4 shadow-[0_0_10px_rgba(34,211,238,0.5)]"></div>
    </div>

    <!-- Stats cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      
      <!-- Card: Repos -->
      <div class="scroll-animate-scale scroll-delay-1 group bg-zinc-950 border border-zinc-800 rounded-2xl p-6 shadow-lg hover:border-cyan-500/30 transition-all duration-300 text-center">
        <div class="w-14 h-14 mx-auto mb-4 rounded-xl border border-zinc-800 bg-zinc-900 flex items-center justify-center group-hover:border-cyan-500/50 group-hover:text-cyan-400 transition-colors">
          <svg class="w-7 h-7 text-zinc-400 group-hover:text-cyan-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
          </svg>
        </div>
        <div id="stat-repos" class="text-3xl font-bold text-white mb-1">—</div>
        <p class="text-sm text-zinc-400 font-medium">Repositorios Públicos</p>
      </div>

      <!-- Card: Followers -->
      <div class="scroll-animate-scale scroll-delay-2 group bg-zinc-950 border border-zinc-800 rounded-2xl p-6 shadow-lg hover:border-cyan-500/30 transition-all duration-300 text-center">
        <div class="w-14 h-14 mx-auto mb-4 rounded-xl border border-zinc-800 bg-zinc-900 flex items-center justify-center group-hover:border-cyan-500/50 group-hover:text-cyan-400 transition-colors">
          <svg class="w-7 h-7 text-zinc-400 group-hover:text-cyan-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <div id="stat-followers" class="text-3xl font-bold text-white mb-1">—</div>
        <p class="text-sm text-zinc-400 font-medium">Seguidores</p>
      </div>

      <!-- Card: Following -->
      <div class="scroll-animate-scale scroll-delay-3 group bg-zinc-950 border border-zinc-800 rounded-2xl p-6 shadow-lg hover:border-cyan-500/30 transition-all duration-300 text-center">
        <div class="w-14 h-14 mx-auto mb-4 rounded-xl border border-zinc-800 bg-zinc-900 flex items-center justify-center group-hover:border-cyan-500/50 group-hover:text-cyan-400 transition-colors">
          <svg class="w-7 h-7 text-zinc-400 group-hover:text-cyan-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
          </svg>
        </div>
        <div id="stat-following" class="text-3xl font-bold text-white mb-1">—</div>
        <p class="text-sm text-zinc-400 font-medium">Siguiendo</p>
      </div>
    </div>

    <!-- GitHub contribution graph -->
    <div class="scroll-animate scroll-delay-2">
      <div class="bg-zinc-950 border border-zinc-800 rounded-2xl p-6 shadow-lg overflow-hidden">
        <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-cyan-400" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          Contribuciones
        </h3>
        <img 
          src={`https://ghchart.rshah.org/22d3ee/${username}`}
          alt="GitHub Contribution Chart"
          class="w-full rounded-lg"
          loading="lazy"
        />
      </div>
    </div>

    <!-- CTA to GitHub -->
    <div class="text-center mt-8 scroll-animate">
      <a 
        href={`https://github.com/${username}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 bg-gray-900 dark:bg-white text-white dark:text-gray-900 font-semibold rounded-xl hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        Ver mi perfil en GitHub
      </a>
    </div>

  </div>
</section>

<script define:vars={{ username }}>
  // Fetch GitHub stats
  async function fetchGitHubStats() {
    try {
      const res = await fetch(`https://api.github.com/users/${username}`);
      if (!res.ok) return;
      const data = await res.json();

      const reposEl = document.getElementById('stat-repos');
      const followersEl = document.getElementById('stat-followers');
      const followingEl = document.getElementById('stat-following');

      // Animate number counting
      function animateNumber(el, target) {
        if (!el) return;
        let current = 0;
        const increment = Math.max(1, Math.floor(target / 30));
        const timer = setInterval(() => {
          current += increment;
          if (current >= target) {
            current = target;
            clearInterval(timer);
          }
          el.textContent = current;
        }, 40);
      }

      animateNumber(reposEl, data.public_repos);
      animateNumber(followersEl, data.followers);
      animateNumber(followingEl, data.following);

    } catch (err) {
      console.warn('Could not fetch GitHub stats:', err);
    }
  }

  // Fetch when section is visible
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        fetchGitHubStats();
        observer.disconnect();
      }
    });
  }, { threshold: 0.1 });

  const section = document.querySelector('#stat-repos')?.closest('section');
  if (section) observer.observe(section);
</script>
